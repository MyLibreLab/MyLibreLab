# ############################################################################
# ## General Build Artifacts & Dependencies
# ############################################################################

# Ignore Gradle's build output directory. This is the most important rule.
/build/

# Ignore the .gradle directory, which caches downloaded dependencies and other build data.
/.gradle/

# Ignore Gradle task cache.
.gradletasknamecache

# Ignore build output from the buildSrc directory.
/buildSrc/build/
/buildSrc/.gradle/

# ############################################################################
# ## IDE-Specific Files
# ############################################################################

# Intellij IDEA
# Ignore the entire .idea directory, which stores user-specific settings.
.idea/

# Eclipse
.classpath
.project
.settings/
.factorypath
.springBeans
.pydevproject
.cproject
.autotools
.buildpath
.externalToolBuilders/
*.launch

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/

# VS Code
.vscode/

# ############################################################################
# ## Compiled Code & Packages
# ############################################################################

# Compiled Java and Kotlin class files.
*.class

# Packaged archives. These are generated from the build process.
*.jar
*.war
*.ear
*.zip
*.tar
*.tar.gz

# ############################################################################
# ## Logs & Temporary Files
# ############################################################################

# Log files
*.log
logs/

# JVM crash logs
hs_err_pid*

# Temporary files and backups
*.tmp
*.bak
*.swp

# ############################################################################
# ## Operating System Files
# ############################################################################

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.Trash-*

# ############################################################################
# ## Project-Specific Ignores
# ############################################################################

# Personal To-Do files. Use the project's issue tracker instead.
ToDo.txt