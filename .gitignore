# ############################################################################
# ## General Build Artifacts & Dependencies
# ############################################################################

# Ignore all build output directories from Gradle (for multi-module projects)
**/build/

# Ignore the .gradle directory, which caches downloaded dependencies and other build data.
/.gradle/

# Ignore Gradle task cache
.gradletasknamecache

# Ignore build output from the buildSrc directory.
/buildSrc/build/
/buildSrc/.gradle/

# ############################################################################
# ## Legacy & Custom Build Artifacts
# ############################################################################

# Ignore legacy 'bin' directories from the custom elements build process
**/bin/

# Ignore Java Application Descriptor files
*.jad

# ############################################################################
# ## IDE-Specific Files
# ############################################################################

# Intellij IDEA
.idea/

# Eclipse
.classpath
.project
.settings/
.factorypath

# ############################################################################
# ## Compiled Code & Packages
# ############################################################################

# Compiled Java and Kotlin class files
*.class

# Packaged archives
*.jar
*.war
*.ear
*.zip
*.tar
*.tar.gz

# ############################################################################
# ## Logs & Temporary Files
# ############################################################################

# Log files
*.log
logs/

# JVM crash logs
hs_err_pid*

# ############################################################################
# ## Operating System Files
# ############################################################################

# macOS
.DS_Store

# Windows
Thumbs.db

# ############################################################################
# ## Project-Specific Ignores
# ############################################################################

# Personal To-Do files [cite: 7, 11]
ToDo.txt
.github/act-secrets
