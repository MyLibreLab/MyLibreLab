# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for specific file types
*.gradle.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary